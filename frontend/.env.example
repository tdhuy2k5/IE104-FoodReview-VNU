# Use /api with the Vite dev proxy, or an absolute API URL for deployment.
VITE_API_BASE_URL=/api
# Docker API: http://localhost:5000; dotnet launch profile: http://localhost:5114
API_PROXY_TARGET=http://localhost:5114
# Optional Maps Embed API key. Restrict by HTTP referrer and Maps Embed API in Google Cloud.
VITE_GOOGLE_MAPS_EMBED_API_KEY=
